main_start	ld	bc,tween_level_selector
		call	play
		call	tick

		ld	a,(level+1)
		ld	(tmplevel+1),a
select_level2
maxlevel	ld	a,0
		ld	b,a
		ld	a,(level+1)
		cp	b
		jr	c,.max
		ld	b,a
		ld	(maxlevel+1),a
.max		ld	d,a ; current level
		ld	e,b ; max level
		inc	e
		ld	hl,levelselect_tmp + LEVEL_CNT - 1
		ld	bc,(LEVEL_CNT << 8) | 1
levelselect_F	ld	a,l
		cp	e
		jr	nc,.unblock
		ld	c,0
.unblock	ld	(hl),c
		ld	a,l
		cp	d
		jr	nz,.next
		set	7,(hl)
.next		dec	l
		djnz	levelselect_F
		ld	l,b
		ld	de,levelselect_tmp + LEVEL_CNT
		ld	c,STAGE_CNT
stageselect	xor	a
		ld	b,LEVEL_CNT / STAGE_CNT
.stageloop	cp	(hl)
		jr	nc,.nextlevel
		ld	a,(hl)
.nextlevel	rlc	(hl)
		inc	l
		djnz	.stageloop
		rlca
		ld	(de),a
		inc	e
		dec	c
		jr	nz,stageselect

		ei
		halt

		ld	a,SPRITE_CONTROL_NR_15
		ld	bc,NEXTREG_SELECT_P_243B
		out	(c),a
		inc	b
		in	a,(c)
		ld	(restore_sprites+3),a
		xor	1 ; disable sprites
		out	(c),a

		xor	a
		ld	(interrupt.disable_glow+1),a
		ld	(interrupt.even+1),a

		ld	a,15
		nextreg	TILEMAP_YOFFSET_NR_31,a
		neg
		nextreg	CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,159,,CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,a
		neg
		ld	b,9
.easeout	ei
		halt
		add	a,25
		nextreg	TILEMAP_YOFFSET_NR_31,a
		neg
		nextreg	CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,159,,CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,a
		neg
		djnz	.easeout

		ld	hl,levelselect_map
		ld	de,tilemap_map
		ld	bc,TILEMAP_CHAR_WIDTH * TILEMAP_CHAR_HEIGHT
		ldir

		ld	a,~242
		nextreg	TILEMAP_YOFFSET_NR_31,a
		neg
		nextreg	CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,159,,CLIP_TILEMAP_NR_1B,a,,CLIP_TILEMAP_NR_1B,255
		ld	hl,menu_animation
		ld	b,18
.easein		ei
		halt
		ld	a,(hl)
		inc	hl
		nextreg	CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,159,,CLIP_TILEMAP_NR_1B,a,,CLIP_TILEMAP_NR_1B,255
		neg
		nextreg	TILEMAP_YOFFSET_NR_31,a
		djnz	.easein

		nextreg	TILEMAP_YOFFSET_NR_31,0
		nextreg	CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,159,,CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,255

		ld	bc,SPRITE_SLOT_SELECT_P_303B
		xor	a
		out	(c),a
		ld	hl,levelselector_sprites
		ld	bc,(levelselector_sprites.length << 8) | SPRITE_ATTRIBUTE_P_57
		otir

restore_sprites	nextreg	SPRITE_CONTROL_NR_15,0

levels_render	ld	iy,tilemap_map + (5 * TILEMAP_CHAR_WIDTH) + 9
		ld	hl,levelselect_tmp + LEVEL_CNT
		ld	de,4
		ld	bc,6 << 8
.stageloop	ld	a,(hl)
		inc	l
		call	draw_level_select_tile
		dec	a
		jr	nz,.stagenext
		ld	a,c
		ld	(.current_stage+1),a
.stagenext	add	bc,LEVEL_CNT / STAGE_CNT
		add	iy,de
		djnz	.stageloop

		ld	iy,tilemap_map + (13 * TILEMAP_CHAR_WIDTH) + 7
.current_stage	ld	l,0
		ld	c,4
		ld	e,6
.loopY		ld	b,5
.loopX		ld	a,(hl)
		inc	l
		call	draw_level_select_tile
		add	iy,de
		djnz	.loopX
		dec	c
		jr	z,level_select
		push	de
		ld	de,(3 * TILEMAP_CHAR_WIDTH) + 10
		add	iy,de
		pop	de
		jr	.loopY

level_select	call	get_controls.entry
		jr	z,level_select
		cp	K_BREAK
		jr	z,level_continue
		cp	K_EDIT
		jr	z,level_continue
		cp	K_FIRE
		jr	z,level_play
		cp	K_LEFT
		jr	z,level_down
		cp	K_DOWN
		jr	z,level_pgup
		cp	K_UP
		jr	z,level_pgdown
		cp	K_RIGHT
		jr	nz,level_select

level_up	ld	a,(maxlevel+1)
		ld	e,a
		ld	a,(level+1)
		cp	e
		jr	nc,level_select
		ld	e,a
		inc	a
		jr	level_set

level_down	ld	a,(level+1)
		or	a
		jr	z,level_select
		ld	e,a
		dec	a
		jr	level_set

level_pgup	ld	a,(maxlevel+1)
		ld	e,a
		ld	a,(level+1)
		add	a,7
		cp	e
		jr	nc,level_select
		ld	a,(level+1)
		ld	e,a
		add	a,8
		jr	level_set

level_pgdown	ld	a,(level+1)
		cp	8
		jr	c,level_select
		ld	e,a
		sub	8
		jr	level_set

level_set	call	tick
		ld	(level+1),a
;		call	highlight_level
;		ld	a,(level+1)
;		ld	e,a
;		call	highlight_level
		call	key_delay
		jr	level_select
		ret

level_play	call	tick
		ld	a,(tmplevel+1)
		ld	e,a
		ld	a,(level+1)
		cp	e
		jp	nz,main_start

level_continue	call	tick
		ld	a,(tmplevel+1)
		cp	-1
		jp	z,main_start
		ld	(level+1),a
		jp	main_start

draw_level_select_tile
		push	af
		push	hl
		rlca
		add	a,low levelselect_bubble_map
		ld	h,high levelselect_bubble_map
		ld	l,a
		jr	nc,.nc
		inc	h
.nc		ld	a,(hl)
		call	draw_tiles_by_base
		inc	hl
		ld	a,(hl)
		ld	(iy + 0),a
		ld	(iy + 1),a
		ld	(iy + TILEMAP_CHAR_WIDTH),a
		ld	(iy + TILEMAP_CHAR_WIDTH + 1),a
		pop	hl
		pop	af
		ret

levelselect_bubble_map
		db	tilemap.base.ptr, tilemap.tilebackground
		db	tilemap.colorblob.C1, tilemap.base.C1
		db	tilemap.colorblob.C2, tilemap.base.C2
