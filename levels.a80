main_start	ld	bc,tween_level_selector
		call	start_level
		call	tick

		ld	a,(level+1)
		ld	(tmplevel+1),a
		ld	hl,tilemap_map
		ld	de,tilemap_map + tilemap_map.sz
		ld	bc,tilemap_map.sz
		ldir
		ld	a,#C3
		ld	(tween_level_tilemap.redraw_overlays),a

select_level2
maxlevel	ld	a,0
		ld	b,a
		ld	a,(level+1)
		cp	b
		jr	c,.max
		ld	b,a
		ld	(maxlevel+1),a
.max		ld	d,a ; current level
		ld	e,b ; max level
		inc	e
		ld	hl,levelselect_tmp + LEVEL_CNT - 1
		ld	bc,(LEVEL_CNT << 8) | 0
levelselect_F	ld	a,l
		cp	e
		jr	nc,.unblock
		ld	c,1
.unblock	ld	(hl),c
		ld	a,l
		cp	d
		jr	nz,.next
		ld	(hl),2
.next		dec	l
		djnz	levelselect_F
		ld	l,b
		ld	de,levelselect_tmp + LEVEL_CNT
		ld	c,STAGE_CNT
stageselect	xor	a
		ld	b,LEVELS_PER_STAGE
.stageloop	cp	(hl)
		jr	nc,.nextlevel
		ld	a,(hl)
.nextlevel	inc	l
		djnz	.stageloop
		ld	(de),a
		inc	e
		dec	c
		jr	nz,stageselect

		ei
		halt
		nextreg	SPRITE_CONTROL_NR_15,SPRITE_CONTROL_DEFAULTS

		xor	a
		ld	(interrupt.disable_glow+1),a
		ld	(interrupt.even+1),a

		ld	a,15
		nextreg	TILEMAP_YOFFSET_NR_31,a
		neg
		nextreg	CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,159,,CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,a
		neg
		ld	b,9
.easeout	ei
		halt
		add	a,25
		nextreg	TILEMAP_YOFFSET_NR_31,a
		neg
		nextreg	CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,159,,CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,a
		neg
		djnz	.easeout

		ld	hl,levelselect_map
		ld	de,tilemap_map
		ld	bc,TILEMAP_CHAR_WIDTH * TILEMAP_CHAR_HEIGHT
		ldir

		ld	a,~242
		nextreg	TILEMAP_YOFFSET_NR_31,a
		neg
		nextreg	CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,159,,CLIP_TILEMAP_NR_1B,a,,CLIP_TILEMAP_NR_1B,255
		ld	hl,menu_animation
		ld	b,18
.easein		ei
		halt
		ld	a,(hl)
		inc	hl
		nextreg	CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,159,,CLIP_TILEMAP_NR_1B,a,,CLIP_TILEMAP_NR_1B,255
		neg
		nextreg	TILEMAP_YOFFSET_NR_31,a
		djnz	.easein

		nextreg	TILEMAP_YOFFSET_NR_31,0
		nextreg	CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,159,,CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,255

		ld	bc,SPRITE_SLOT_SELECT_P_303B
		xor	a
		out	(c),a
		ld	hl,levelselector_sprites
		ld	bc,(levelselector_sprites.length << 8) | SPRITE_ATTRIBUTE_P_57
		otir

		ld	a,#CD
		ld	(main_start),a
		nextreg	SPRITE_CONTROL_NR_15,SPRITE_CONTROL_DEFAULTS + 1

level_sel_loop	call	levels_render
level_select	call	get_controls.entry
		jr	z,level_select
		cp	K_BREAK
		jp	z,level_continue
		cp	K_EDIT
		jp	z,level_continue
		cp	K_FIRE
		jp	z,level_play
		cp	K_LEFT
		jr	z,level_left
		cp	K_RIGHT
		jr	z,level_right
		cp	K_DOWN
		jr	z,level_down
		cp	K_UP
		jr	nz,level_select

level_up	call	get_level_location
		cp	5
		jr	c,level_select
		ld	a,d
		sub	5
		jr	nc,level_set
		xor	a
		jr	level_set

level_down	call	get_level_location
		cp	15
		jr	nc,level_select
		ld	a,d
		add	a,5
		cp	e
		jr	c,level_set
		ld	a,e
		jr	level_set

level_set	call	tick
		ld	(level+1),a
		ld	l,d
		ld	d,a
		ld	h,high levelselect_tmp
		ld	a,(hl)
		ld	(hl),1
		ld	l,d
		ld	(hl),a
		ld	e,LEVEL_CNT
		ld	a,b
		add	a,e
		ld	l,a
		ld	a,d
		ld	d,(hl)
		ld	(hl),1
		call	get_level_location.modulo20
		ld	a,b
		add	a,e
		ld	l,a
		ld	(hl),d
		call	key_delay
		jp	level_sel_loop

level_right	call	get_level_location
		ld	l,1
		cp	19
		jr	nz,.onstage1
		ld	l,16
.onstage1	cp	14
		jr	nz,.onstage2
		ld	l,16
.onstage2	cp	9
		jr	nz,.onstage3
		ld	l,16
.onstage3	cp	4
		jr	nz,.process
		ld	l,16
.process	ld	a,d
		add	a,l
		cp	e
		jr	c,level_set
		ld	a,e
		jr	level_set

level_left	call	get_level_location
		ld	l,1
		cp	15
		jr	nz,.onstage1
		ld	l,16
.onstage1	cp	10
		jr	nz,.onstage2
		ld	l,16
.onstage2	cp	5
		jr	nz,.onstage3
		ld	l,16
.onstage3	or	a
		jr	nz,.process
		ld	l,16
.process	ld	a,d
		sub	l
		jr	nc,level_set
		ld	a,l
		cp	16
		jp	z,level_select
		xor	a
		jr	level_set

level_play	call	tick
		ld	de,(tmplevel+1)
		ld	a,(level+1)
		cp	e
		jp	nz,main_start

level_continue	call	tick
		ld	a,(tmplevel+1)
		cp	-1
		jp	z,main_start
		ld	(level+1),a
		jp	main_start

; returns d = current level, e = max level, b = stage, a/c = modulo 20
get_level_location
		ld	a,(maxlevel+1)
		ld	e,a
		ld	a,(level+1)
		ld	d,a
.modulo20	ld	bc,$FF00 | LEVELS_PER_STAGE
.stage		inc	b
		sub	c
		jr	nc,.stage
		add	a,c
		ld	c,a
		ret

;------------------------------------------------------------------------------

levels_render	ld	iy,tilemap_map + (5 * TILEMAP_CHAR_WIDTH) + 9
		ld	hl,levelselect_tmp + LEVEL_CNT
		ld	de,4 ; offset between tiles
		ld	bc,STAGE_CNT << 8
.stageloop	ld	a,(hl)
		inc	l
		call	draw_level_select_tile
		dec	a
		dec	a
		jr	nz,.stagenext
		ld	a,c
		ld	(.current_stage+1),a
.stagenext	add	bc,LEVELS_PER_STAGE
		add	iy,de
		djnz	.stageloop

		ld	iy,tilemap_map + (13 * TILEMAP_CHAR_WIDTH) + 7
.current_stage	ld	l,0
		ld	e,6 ; offset between tiles
		ld	c,4
.loopY		ld	b,5
.loopX		ld	a,(hl)
		inc	l
		call	draw_level_select_tile
		add	iy,de
		djnz	.loopX
		dec	c
		ret	z
		push	de
		ld	de,(3 * TILEMAP_CHAR_WIDTH) + 10
		add	iy,de
		pop	de
		jr	.loopY

draw_level_select_tile
		push	af
		push	hl
		rlca
		add	a,low levelselect_bubble_map
		ld	h,high levelselect_bubble_map
		ld	l,a
		jr	nc,.nc
		inc	h
.nc		ld	a,(hl)
		call	draw_tiles_by_base
		inc	hl
		ld	a,(hl)
		ld	(iy + 0),a
		ld	(iy + 1),a
		ld	(iy + TILEMAP_CHAR_WIDTH),a
		ld	(iy + TILEMAP_CHAR_WIDTH + 1),a
		pop	hl
		pop	af
		ret

levelselect_bubble_map
		db	tilemap.colorblob.C2, tilemap.base.C2
		db	tilemap.base.ptr, tilemap.tilebackground
		db	tilemap.colorblob.C1, tilemap.base.C1

;------------------------------------------------------------------------------

restore_level_selector
		call	reset_gloworb
		call	reset_crossoverlay
		call	redraw_numerals
		call	update_gloworb.ptr
		nextreg	SPRITE_CONTROL_NR_15,SPRITE_CONTROL_DEFAULTS+1
		ld	a,#C9
		ld	(tween_level_tilemap.redraw_overlays),a
		ld	a,1
		ld	(interrupt.disable_glow+1),a
		ld	(main_start),a
		ret
