read_next_reg:	ld	bc,NEXTREG_SELECT_P_243B
		out	(c),a
		inc	b
		in	a,(c)
		ret

;------------------------------------------------------------------------------
; HL = memory: N * 16b data (RRRGGGBB, p000000B bytes)
; D = starting index of palette
; E = count-size of palette data (0 is 256 colours)
; A = value to select palette to upload via NR_43
upload_palette:	push	af
		nextreg	PALETTE_CONTROL_NR_43,a
		ld	a,d
		nextreg	PALETTE_INDEX_NR_40,a
		ld	bc,NEXTREG_SELECT_P_243B
		ld	a,PALETTE_VALUE_9BIT_NR_44
		out	(c),a
		inc	b
.pal_loop:	outinb
		outinb
		dec	e
		jr	nz,.pal_loop
		pop	af
		ret

;------------------------------------------------------------------------------
; HL = tilemap offset
; returning HL = real X, A = real Y
calc_tilemap_offset_to_xy:
		xor	a
		res	6,h
		ld	bc,TILEMAP_CHAR_WIDTH
.row		ex	af,af'
		xor	a
		or	h
		jr	nz,.nextrow
		or	l
		cp	TILEMAP_CHAR_WIDTH
		jr	nc,.nextrow
		add	hl,hl
		add	hl,hl
		add	hl,hl
		ex	af,af'
		rlca
		rlca
		rlca
		ret

.nextrow	xor	a
		sbc	hl,bc
		ex	af,af'
		inc	a
		jr	.row

;------------------------------------------------------------------------------
; A = playfield offset
; returning HL = real X, A = real Y
calc_playfield_offset_to_xy:
		push	de
		ld	de,$FF00 | PLAYFIELD_W
.row		inc	d
		sub	e
		jr	nc,.row
		add	a,e	; X * 32
		ld	hl,-1
		rlca
		rlca
		add	hl,a
		add	hl,hl
		add	hl,hl
		add	hl,hl	; store to HL
.playfield_x	add	hl,0
		ld	a,d	; Y * 32
		swapnib
		rlca
.playfield_y	add	a,0
		sub	8
		pop	de
		ret

;------------------------------------------------------------------------------
; A = dialog starting page
layer2_clear_screen_and_transfer_dialog
		cp	0
		ret	z
		ld	(layer2_clear_screen_and_transfer_dialog+1),a
		ex	af,af'
		ld	a,MMU_PG_LAYER2
		call	.filltwo
		ld	b,6
.loop		push	bc
		nextreg	MMU7_E000_NR_57,a
		inc	a
		ex	af,af'
		nextreg	MMU6_C000_NR_56,a
		inc	a
		ex	af,af'
		ld	hl,$C000
		ld	de,$E000
		ld	bc,$2000
		ldir
		pop	bc
		djnz	.loop

.filltwo	nextreg	MMU7_E000_NR_57,a
		ld	hl,$E000
		ld	de,$E001
		ld	bc,$1FFF
		ld	(hl),PAL_COLOR_TRANSPARENT
		push	hl
		push	de
		push	bc
		ldir
		inc	a
		nextreg	MMU7_E000_NR_57,a
		pop	bc
		pop	de
		pop	hl
		ld	(hl),PAL_COLOR_TRANSPARENT
		ldir
		inc	a
		ret
