; zxnext setup constants
PAGE_LAYER2_BANK	= 9
ACTIVATE_2ND_PALETTES	= ACT_PALETTE_ULA_2ND | ACT_PALETTE_LAYER2_2ND | ACT_PALETTE_SPRITE_2ND
RGB_COLOR_TRANSPARENT	= $1C7 >> 1
RGB_COLOR_BACKGROUND	= $1F5 >> 1
SPRITE_CONTROL_DEFAULTS	= %00100110 ; LoRes=0, SprToTop, Sclip=1, LSU, Sborder

; playfield & level constants
LEVEL_CNT		= 120
STAGE_CNT		= 6
LEVELS_PER_STAGE	= (LEVEL_CNT / STAGE_CNT)
LEVEL_WIDTH		= 9
LEVEL_HEIGHT		= 7
STEP_COUNT_SIZE		= 4
LEVEL_SIZE		= (LEVEL_WIDTH * LEVEL_HEIGHT) + 1 + STEP_COUNT_SIZE

; playfield allocation constants
	struct S_CROSS_ATTR
location	byte	-1
sprite_slot	byte	-1
tile_first	byte	0
tile_second	byte	0
	ends

; 1 tile gap for board checks
PLAYFIELD_W		= LEVEL_WIDTH + 1
PLAYFIELD_H		= LEVEL_HEIGHT + 1

PLAYFIELD_CHECK_SIZE	= (PLAYFIELD_W * LEVEL_HEIGHT)
PLAYFIELD_SIZE		= (PLAYFIELD_W * PLAYFIELD_H)
PLAYFIELD_BACKUP_SIZE	= PLAYFIELD_SIZE + 2 + (2 * STEP_COUNT_SIZE)
PLAYFIELD_SNAPSHOT_SIZE	= PLAYFIELD_BACKUP_SIZE + (6 * S_CROSS_ATTR) ; = 114
UNDO_LEVELS		= 9

; tilemap rendering constants
TILEFIELD_OFFSET_BASE	= (2 * TILEMAP_CHAR_WIDTH) + 3
TILEFIELD_TILE_HEIGHT	= TILEMAP_CHAR_WIDTH * 4
STATUSBAR_LEVEL_NUMBER	= (TILEMAP_CHAR_WIDTH * (TILEMAP_CHAR_HEIGHT - 2)) + 8
STATUSBAR_COLOR_TICK	= (TILEMAP_CHAR_WIDTH * (TILEMAP_CHAR_HEIGHT - 1)) - 9
LEVEL_SELECTOR_NUMBER	= (TILEMAP_CHAR_WIDTH * (TILEMAP_CHAR_HEIGHT - 3)) + 18

; MMU page layout
MMU_PG_LAYER2		= PAGE_LAYER2_BANK * 2
MMU_PG_TILESET		= 28
MMU_PG_LEVELS		= 29
MMU_PG_SPRITES		= 30
MMU_PG_MUSIC		= 32
MMU_PG_SAMPLES		= 34
MMU_PG_DIALOG		= 37
MMU_PG_MENU		= 43

; game color palette
PAL_COLOR_BLACK		= 0
PAL_COLOR_TILEBACK	= 1
PAL_COLOR_BLOB		= 2
PAL_COLOR_BLOCKED	= 3
PAL_COLOR_BLOB_COLOR1	= 4
PAL_COLOR_BLOB_COLOR2	= 5
PAL_COLOR_BLOB_COLOR3	= 6
PAL_COLOR_BLOB_COLOR4	= 7
PAL_COLOR_ACTIVE_COLOR1	= 8
PAL_COLOR_ACTIVE_COLOR2	= 9
PAL_COLOR_ACTIVE_COLOR3	= 10
PAL_COLOR_ACTIVE_COLOR4	= 11
PAL_COLOR_LIGHT_PINK	= 12
PAL_COLOR_LIGHT_TEAL	= 13
PAL_COLOR_BACKGROUND	= 14
PAL_COLOR_TRANSPARENT	= 15
