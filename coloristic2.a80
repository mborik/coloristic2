		opt	--syntax=abf
		device	zxspectrumnext
		cspectmap "coloristic2.map"
		sldopt COMMENT WPMEM, LOGPOINT, ASSERTION

		include	"nextants.inc"
		include	"constants.inc"


		org	$8000


start:		di
		nextreg	TURBO_CONTROL_NR_07,3
		nextreg	PERIPHERAL_2_NR_06,%00000001 ; CPUSpeed off, NMI button off, M1 button off, PS2 off, AY
		nextreg	PERIPHERAL_3_NR_08,%01010000 ; 128k off, Contention off, ABC, Beeper on, DAC off, Timex off, TS off
		nextreg	PERIPHERAL_4_NR_09,%00000000 ; Stereo AY, other cfg off
		nextreg	INTERRUPT_CONTROL_C0,%00000000
		nextreg INTERRUPT_ENABLE_0_ULA_C4,%10000001
		nextreg INTERRUPT_ENABLE_1_CTC_C5,%00000000
		nextreg INTERRUPT_ENABLE_2_UART_C6,%00000000
		nextreg	VIDEO_INTERUPT_CONTROL_NR_22,%00000000
		nextreg	SPRITE_CONTROL_NR_15,%00100111		; LoRes=0, SprToTop, Sclip=1, LSU, Sborder, S=1
		nextreg	SPRITE_TRANSPARENCY_I_NR_4B,PAL_COLOR_TRANSPARENT
		nextreg	DISPLAY_CONTROL_NR_69,$00		; Layer2=0, ULA bank5, Timex off (regular ULA)
		nextreg	LAYER2_RAM_BANK_NR_12,PAGE_LAYER2_BANK
		nextreg	GLOBAL_TRANSPARENCY_NR_14,$E3		; $1C7 as transparent color
		nextreg	LAYER2_CONTROL_NR_70,%00010000		; 320x256x8bpp, palette offset 0
		nextreg	LAYER2_XOFFSET_MSB_NR_71,0,,LAYER2_XOFFSET_NR_16,0,,LAYER2_YOFFSET_NR_17,0
		nextreg	CLIP_WINDOW_CONTROL_NR_1C,15
		nextreg	CLIP_LAYER2_NR_18,0,,CLIP_LAYER2_NR_18,159,,CLIP_LAYER2_NR_18,0,,CLIP_LAYER2_NR_18,255
		nextreg	CLIP_SPRITE_NR_19,0,,CLIP_SPRITE_NR_19,159,,CLIP_SPRITE_NR_19,0,,CLIP_SPRITE_NR_19,255
		nextreg	CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,159,,CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,255
		nextreg	ULA_CONTROL_NR_68,%11100000		; ULA=off, TM blend, 0 half scroll, defaults for others
		nextreg	TILEMAP_CONTROL_NR_6B,%10110000		; TM=on,40x32x1,Pal2,4bpp,index8,UT
		nextreg	TILEMAP_DEFAULT_ATTR_NR_6C,%00000000	; Pal offset=0, no mirror, no rotate, ULA over TM
		nextreg	TILEMAP_XOFFSET_MSB_NR_2F,0,,TILEMAP_XOFFSET_LSB_NR_30,0,,TILEMAP_YOFFSET_NR_31,0
		nextreg	TILEMAP_TRANSPARENCY_I_NR_4C,PAL_COLOR_TRANSPARENT
		nextreg	TILEMAP_BASE_ADR_NR_6E,high(MEM_TILEMAP_DAT_4000)
		nextreg	TILEMAP_GFX_ADR_NR_6F,high(MEM_TILEMAP_GFX_6000)
		nextreg	PALETTE_FORMAT_NR_42,-1
		nextreg	TRANSPARENCY_FALLBACK_COL_NR_4A,$FA

	; load sprite palette
		ld	a,%01101110
		ld	hl,base_palette
		ld	de,low(base_palette.count)
		call	upload_palette

	; load L2 palette
		ld	a,%01011110
		ld	hl,base_palette
		ld	de,low(base_palette.count)
		call	upload_palette

	; load tilemode palette
		ld	a,%01111110
		ld	hl,base_palette
		ld	de,low(base_palette.count)
		call	upload_palette

	; load ULA palette
		ld	a,%01001110
		ld	hl,base_palette + 16
		ld	de,$0008
		call	upload_palette
		ld	hl,base_palette
		ld	de,$0808
		call	upload_palette
		ld	hl,base_palette + 16
		ld	de,$1008
		call	upload_palette
		ld	hl,base_palette
		ld	de,$1808
		call	upload_palette

		ld	a,PAL_COLOR_BACKGROUND
		out	(ULA_P_FE),a

		ld	bc,SPRITE_SLOT_SELECT_P_303B
		xor	a
		out	(c),a	; select slot 0 for patterns (selects also index 0 for attributes)
		nextreg	MMU6_C000_NR_56, sprite_data.page
		nextreg	MMU7_E000_NR_57, sprite_data.page + 1
		ld	hl,sprite_data
		ld	bc,SPRITE_PATTERN_P_5B
		ld	a,sprite_data.count / 2
.spriteupload	otir
		dec	a
		jr	nz,.spriteupload

		nextreg	MMU7_E000_NR_57, tilemap_gfx.page
		ld	hl,tilemap_gfx
		ld	de,MEM_TILEMAP_GFX_6000
		ld	bc,tilemap_gfx.sz
		ldir

		ld	a,high int_vector
		ld	i,a
		im	2
		ei
		halt

		nextreg	MMU0_0000_NR_50, music.page
		nextreg	MMU1_2000_NR_51, music.page + 1

		call	music_init
		call	detect_kempston

;--------------------------------------------------------------------------------------------
		include "engine.a80"
		include "render.a80"
		include "utils.a80"
		include "interrupt.a80"
		include "music/p3x.a80"
		include "def.tween.inc"

music_muted	db	0
active_color	db	0


		assert	$ < (playground - PLAYFIELD_W)

		align	256

playground	ds	PLAYFIELD_SNAPSHOT_SIZE
.offset_base = playground + PLAYFIELD_SIZE
.active_color = playground + PLAYFIELD_SIZE + 1
.steps = $ - (STEP_COUNT_SIZE * 2)
.current_location = $ - STEP_COUNT_SIZE

undo_area	ds	PLAYFIELD_SNAPSHOT_SIZE * UNDO_LEVELS
.active_color = undo_area + PLAYFIELD_SIZE + 1

		assert	low $ <= high $
		org	(high $) << 8 | (high $)
int_jumper	jp	interrupt

		align	256
int_vector	block	257, high int_jumper

;--------------------------------------------------------------------------------------------
; STACK block
		ds	255
stack:

;--------------------------------------------------------------------------------------------
; DATA/VARIABLES BLOCK

base_palette:	incbin	"gfx/base.pal"	; raw data, include full 256 palette
.count		equ	($ - base_palette) / 2


		include "def.sprites.inc"
		include "def.tiles.inc"


		assert	$ < $C000

		mmu	$E000 w, MMU_PG_TILESET, $E000
;--------------------------------------------------------------------------------------------
; Tilemap data
tilemap_gfx:	incbin	"tileset/tileset.spr"
.page		equ	$$tilemap_gfx
.sz		equ	$ - tilemap_gfx

tilemap_map:	equ	MEM_TILEMAP_DAT_4000
.sz		equ	TILEMAP_CHAR_WIDTH * TILEMAP_CHAR_HEIGHT


		mmu	6 7, MMU_PG_SPRITES, $C000
;--------------------------------------------------------------------------------------------
; Sprite data
sprite_data:	incbin	"gfx/numerals.spr"
.gloworb	incbin	"gfx/gloworb.spr"
.cross		incbin	"gfx/cross.spr"
.count		equ	($ - sprite_data) / 128
.page		equ	$$sprite_data
		assert	$$ == $$sprite_data + 1	; must fit into two pages


		mmu	0 1, MMU_PG_MUSIC, $0000
;--------------------------------------------------------------------------------------------
; Music
music:		incbin	"music/final.pt3"
		assert	$$ == $$music + 1	; must fit into two pages
		block	$4000 - $
.page		equ	$$music


		mmu	$C000 w, MMU_PG_LEVELS, $C000
;--------------------------------------------------------------------------------------------
; Level data
levels:		incbin	"levels/levels.bin"
.page		equ	$$levels
		assert	$$ == $$levels		; must fit into one page


		mmu	$E000 n, MMU_PG_DIALOG, $E000
;--------------------------------------------------------------------------------------------
; Layer2 graphics data
nxi_dialog:	incbin	"gfx/dialog.nxi"
.page		equ	$$nxi_dialog

nxi_menu:	incbin	"gfx/menu.nxi"
.page		equ	$$nxi_menu


;--------------------------------------------------------------------------------------------
		savenex	OPEN "coloristic2.nex",start,stack
		savenex	CORE 3,1,5
		savenex	CFG 0,0
		savenex	AUTO
		savenex	CLOSE
