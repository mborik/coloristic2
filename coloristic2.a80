		opt	--syntax=abf
		device	zxspectrumnext
		cspectmap "coloristic2.map"
		sldopt COMMENT WPMEM, LOGPOINT, ASSERTION

		include	"nextants.inc"
		include	"constants.inc"


		org	$8000


start:		nextreg	TURBO_CONTROL_NR_07,2
;	; check for 50/60Hz mode and remember it -> to repeat keyboard handler calls (before making proper 300Hz inputs)
;		ld	a,PERIPHERAL_1_NR_05
;		call	ReadNextReg
;		.3	rra					; CF=1 60Hz, 0 for 50Hz
;		ld	a,300/50
;		sbc	a,0					; A = 6 for 50Hz, 5 for 60Hz
;		ld	(main_loop.keyboard_handler_repeat),a
;		nextreg	LAYER2_RAM_BANK_NR_12,$$l2_pix_data/2
		nextreg	SPRITE_CONTROL_NR_15,%00000111		; LoRes=0, SprToTop, Sclip=0, LSU, Sborder, S=1
		nextreg SPRITE_TRANSPARENCY_I_NR_4B,$0F
		nextreg	DISPLAY_CONTROL_NR_69,$00		; Layer2=0, ULA bank5, Timex off (regular ULA)
		nextreg	LAYER2_CONTROL_NR_70,%00100000		; 640x256x4bpp, palette offset 0
		nextreg	LAYER2_XOFFSET_MSB_NR_71,0,,LAYER2_XOFFSET_NR_16,0,,LAYER2_YOFFSET_NR_17,0
		nextreg	CLIP_WINDOW_CONTROL_NR_1C,$0F
		nextreg	CLIP_LAYER2_NR_18,0,,CLIP_LAYER2_NR_18,159,,CLIP_LAYER2_NR_18,0,,CLIP_LAYER2_NR_18,255
		nextreg	CLIP_SPRITE_NR_19,0,,CLIP_SPRITE_NR_19,159,,CLIP_SPRITE_NR_19,0,,CLIP_SPRITE_NR_19,255
		nextreg	CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,159,,CLIP_TILEMAP_NR_1B,0,,CLIP_TILEMAP_NR_1B,255
		nextreg	ULA_CONTROL_NR_68,%11100000		; ULA=off, TM blend, 0 half scroll, defaults for others
		nextreg	TILEMAP_CONTROL_NR_6B,%10110000		; TM=on,40x32x1,Pal2,4bpp,index8,UT
		nextreg	TILEMAP_XOFFSET_MSB_NR_2F,0,,TILEMAP_XOFFSET_LSB_NR_30,0,,TILEMAP_YOFFSET_NR_31,0
		nextreg	TILEMAP_TRANSPARENCY_I_NR_4C,$0F
		nextreg	TILEMAP_BASE_ADR_NR_6E,high(MEM_TILEMAP_DAT_4000),,TILEMAP_GFX_ADR_NR_6F,high(MEM_TILEMAP_GFX_6000)
		nextreg	TRANSPARENCY_FALLBACK_COL_NR_4A,0

	; load sprite palette
		ld	a,%01101110
		ld	hl,base_palette
		ld	de,low(base_palette.count)
		call	upload_palette

	; load tilemode palette
		ld	a,%01111110
		ld	hl,base_palette
		ld	de,low(base_palette.count)
		call	upload_palette

	; load ULA palette
		ld	a,%01001110
		ld	hl,base_palette + 16
		ld	de,$0008
		call	upload_palette
		ld	hl,base_palette
		ld	de,$0808
		call	upload_palette
		ld	hl,base_palette + 16
		ld	de,$1008
		call	upload_palette
		ld	hl,base_palette
		ld	de,$1808
		call	upload_palette

		ld	a,PAL_COLOR_BACKGROUND
		out	(ULA_P_FE),a

		ld	bc,SPRITE_SLOT_SELECT_P_303B
		xor	a
		out	(c),a	; select slot 0 for patterns (selects also index 0 for attributes)
		nextreg	MMU6_C000_NR_56, sprite_data.page
		nextreg	MMU7_E000_NR_57, sprite_data.page + 1
		ld	hl,sprite_data
		ld	bc,SPRITE_PATTERN_P_5B
		ld	a,sprite_data.count / 2
.spriteupload	otir
		dec	a
		jr	nz,.spriteupload

		nextreg	MMU7_E000_NR_57, tilemap_gfx.page
		ld	hl,tilemap_gfx
		ld	de,MEM_TILEMAP_GFX_6000
		ld	bc,tilemap_gfx.sz
		ldir

		nextreg	MMU6_C000_NR_56, levels.page

;--------------------------------------------------------------------------------------------
		include "engine.a80"
		include "render.a80"
		include "utils.a80"

active_color	db	0
music_muted	db	0


		align	256

playground	ds	PLAYFIELD_SIZE
.steps = $ - (STEP_COUNT_SIZE * 2)
.current_location = $ - STEP_COUNT_SIZE

undo_area	ds	PLAYFIELD_SIZE * UNDO_LEVELS

;--------------------------------------------------------------------------------------------
; STACK block >256 bytes
		align	256
		ds	256
stack:

;--------------------------------------------------------------------------------------------
; DATA/VARIABLES BLOCK

base_palette:	incbin	"gfx/base.pal"	; raw data, include full 256 palette
.count		equ	($ - base_palette) / 2


		include "def.sprites.inc"
		include "def.tiles.inc"


		assert	$ < $C000

		mmu	$E000 w, MMU_PG_TILESET, $E000
;--------------------------------------------------------------------------------------------
; Tilemap data
tilemap_gfx:	incbin	"tileset/tileset.spr"
.page		equ	$$tilemap_gfx
.sz		equ	$ - tilemap_gfx

tilemap_map:	equ	MEM_TILEMAP_DAT_4000
.sz		equ	TILEMAP_CHAR_WIDTH * TILEMAP_CHAR_HEIGHT


		mmu	6 7, MMU_PG_SPRITES, $C000
;--------------------------------------------------------------------------------------------
; Sprite data
sprite_data:	incbin	"gfx/numerals.spr"
.gloworb	incbin	"gfx/gloworb.spr"
.count		equ	($ - sprite_data) / 128
.page		equ	$$sprite_data
		assert	$$ == $$sprite_data + 1	; must fit into two pages


		mmu	$C000 w, MMU_PG_LEVELS, $C000
;--------------------------------------------------------------------------------------------
; Level data
levels:		incbin	"levels/levels.bin"
.page		equ	$$levels
		assert	$$ == $$levels		; must fit into one page


;--------------------------------------------------------------------------------------------
		savenex	OPEN "coloristic2.nex",start,stack
		savenex	CORE 3,1,5
		savenex	CFG 0,0
		savenex	AUTO
		savenex	CLOSE
