prepare_level	cp	-1
		ret	z
		cp	LEVEL_CNT
		jr	c,.copy2pg

		xor	a
.copy2pg	ld	d,a
		ld	e,LEVEL_SIZE
		mul	d,e
		ld	hl,levels
		add	hl,de
		ld	de,playground
		ld	bc,LEVEL_SIZE
		ld	a,e
		nextreg	MMU6_C000_NR_56, levels.page
		ldir
		ld	h,d
		ld	l,e
		inc	de
		ld	bc,PLAYFIELD_SIZE*UNDO_LEVELS-1
		ld	(hl),a
		ldir

		dec	bc
		ld	(playground.current_location+0),bc
		ld	(playground.current_location+2),bc
	; save level offset because after undo will not exist
		ld	a,(playground + LEVEL_OFFSET_INDEX)
		ld	(.level_offset+2),a
		ld	a,#CC ; call z
		ld	(.firsttime),a
		ld	(.endno1stTime+1),a
		ld	(store_undo.lastcolor+1),a
		ld	(perform_move.makemove+1),a

.justdraw	ei
		halt
		ld	hl,tilemap_map + PLAYFIELD_OFFSET_BASE
.level_offset	add	hl,0
		ld	ix,playground
		push	hl
	; store playfield offset XY to gloworb position offset
		call	calc_tilemap_offset_to_xy
		ld	(reset_gloworb.playfield_x+2),hl
		ld	(reset_gloworb.playfield_y+1),a
		pop	de
		ld	c,PLAYFIELD_H
.rows		ld	b,PLAYFIELD_W
		push	de
.cols		ld	a,(ix+0)
		or	a
		jr	z,.next
		and	#FC
		cp	4
		push	bc
.firsttime	call	z,startile
		ld	l,(ix+0)
		ld	h,0
		add	hl,hl
		ld	bc,sprite2fntab
		add	hl,bc
		ld	a,(hl)
		ld	(draw_sprite+1),a
		inc	l
		ld	c,(hl)
		ld	yh,d
		ld	yl,e
		call	draw_sprite
		pop	bc
.next		inc	ix
		add	de,4
		djnz	.cols
		pop	de
		add	de,PLAYFIELD_TILE_HEIGHT
		dec	c
		jr	nz,.rows
		call	redraw_numerals
.endno1stTime	ld	a,0
		or	a
		jp	z,reset_gloworb
		ld	a,1
		ld	(.firsttime),a
		dec	a
		ld	(.endno1stTime+1),a
		call	findplayablecolor

; draw border around the game plan
;------------------------------------------------------------------------------
	macro carry_if_nonempty_tile offset?
		ld	a,(ix + offset?)
		or	a
		jr	z,$+3
		cp	d
		rr	l
	endm

draw_border	ld	ix,tilemap_map + TILEMAP_CHAR_WIDTH
		ld	d,tilemap.border.ptr
		ld	b,TILEMAP_CHAR_HEIGHT - 2
.row		ld	c,TILEMAP_CHAR_WIDTH - 1
.col		dec	c
		jr	z,.endline
		inc	ix
		ld	a,(ix)
		or	a
		jr	nz,.col
		ld	l,a
		carry_if_nonempty_tile 1
		carry_if_nonempty_tile TILEMAP_CHAR_WIDTH + 1
		carry_if_nonempty_tile TILEMAP_CHAR_WIDTH
		carry_if_nonempty_tile TILEMAP_CHAR_WIDTH - 1
		carry_if_nonempty_tile -1
		carry_if_nonempty_tile -(TILEMAP_CHAR_WIDTH + 1)
		carry_if_nonempty_tile -TILEMAP_CHAR_WIDTH
		carry_if_nonempty_tile -(TILEMAP_CHAR_WIDTH - 1)
		ld	h,high edges2border
		ld	a,(hl)
		or	a
		jr	z,.col
		ld	(ix),a
		jr	.col

.endline	inc	ix
		inc	ix
		djnz	.row
		ret

; calculate numeral sprite data from starting blob tile
;------------------------------------------------------------------------------
startile	push	de
		ex	hl,de
		call	calc_tilemap_offset_to_xy
		ex	hl,de
		ex	af,af'
		ld	c,3
		ld	a,(ix+0)
		and	c
		ld	b,a
		rlca
		rlca
		add	a,b
		ld	h,high sprattr.numeralC1
		ld	l,a
		ld	(hl),e	; S_SPRITE_ATTR.x
		inc	l
		ex	af,af'
		ld	(hl),a	; S_SPRITE_ATTR.y
		inc	l
		ld	(hl),d	; S_SPRITE_ATTR.palx8

		ld	a,b
		add	a,low playground.current_location
		ld	l,a
		ld	h,high playground.current_location
		ld	a,xl
		ld	(hl),a
		ld	a,b
		xor	c
		rlca
		rlca
		ld	l,a
		ld	h,0
		ld	bc,redraw_numerals.color11+1
		add	hl,bc
		ld	(hl),#FE ; set 7,(hl)
		pop	de
		ret

; tilemap drawings
;------------------------------------------------------------------------------
draw_tiles_by_base
		ld	(iy - TILEMAP_CHAR_WIDTH - 1),a
		inc	a
		ld	(iy - TILEMAP_CHAR_WIDTH + 2),a
		inc	a
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH) - 1),a
		inc	a
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH) + 2),a
		inc	a
		ld	(iy - TILEMAP_CHAR_WIDTH),a
		inc	a
		ld	(iy - TILEMAP_CHAR_WIDTH + 1),a
		inc	a
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH)),a
		inc	a
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH) + 1),a
		inc	a
		ld	(iy - 1),a
		inc	a
		ld	(iy + 2),a
		inc	a
		ld	(iy + TILEMAP_CHAR_WIDTH - 1),a
		inc	a
		ld	(iy + TILEMAP_CHAR_WIDTH + 2),a
		ret

draw_center_of_tile
		ld	(iy + 0),h
		ld	(iy + 1),l
		ld	(iy + TILEMAP_CHAR_WIDTH),b
		ld	(iy + TILEMAP_CHAR_WIDTH + 1),c
		ret

draw_base	ld	a,tilemap.base.ptr
		call	draw_tiles_by_base
		xor	a
		add	a,c
		jr	z,.void
.center		ld	h,a
		inc	a
		ld	l,a
		inc	a
		ld	b,a
		inc	a
		ld	c,a
		jr	draw_center_of_tile

.void		ld	hl,(tilemap.tilebackground << 8) | tilemap.tilebackground
		ld	bc,(tilemap.tilebackground << 8) | tilemap.tilebackground
		jr	draw_center_of_tile

draw_blob	ld	a,c
		call	draw_tiles_by_base
		ld	a,c
		sub	tilemap.colorblob.C1
		swapnib
		add	a,tilemap.base.C1
draw_center_color
		ld	(iy + 0),a
		ld	(iy + 1),a
		ld	(iy + TILEMAP_CHAR_WIDTH),a
		ld	(iy + TILEMAP_CHAR_WIDTH + 1),a
		ret

draw_blocked	ld	a,tilemap.blocked.ptr
		call	draw_tiles_by_base
		ld	a,tilemap.blocked.cross
		jr	draw_base.center

draw_sprite	jr	$+2
		jr	draw_base	; TILE_BASE
		jr	draw_blob	; TILE_BLOB
		jr	draw_blocked	; TILE_BLOCKED
		jr	draw_tele	; TILE_TELE
		jr	draw_path	; TILE_PATH
		jr	draw_cross	; TILE_CROSS
		ret

draw_tele	ld	a,tilemap.base.ptr
		call	draw_tiles_by_base
		ld	a,tilemap.teleport
.phase		add	a,0
		jr	draw_base.center

draw_cross	; TODO setup cross sprite overlay and drop to path code

draw_path	ld	a,c
		and	31
		add	a,low path_corners
		ld	l,a
		ld	h,high path_corners
		ld	a,(hl)
		ex	af,af'
		push	hl
		push	de
		ld	a,c
		swapnib
		rrca
		and	7
		ld	b,a
		dec	a
		swapnib
		ld	c,a
		call	draw_tiles_by_base
		ld	a,tilemap.edging.path_L
		add	a,c
		ld	h,a
		inc	a
		ld	l,a
		inc	a
		ld	d,a
		inc	a
		ld	e,a
		ex	af,af'
		rrca
		jr	nc,.edge1
		ld	(iy - TILEMAP_CHAR_WIDTH - 1),d
		ld	(iy - TILEMAP_CHAR_WIDTH),d
		ld	(iy - 1),b
.edge1		rrca
		jr	nc,.edge2
		ld	(iy - TILEMAP_CHAR_WIDTH - 1),h
		ld	(iy - TILEMAP_CHAR_WIDTH),b
		ld	(iy - 1),h
.edge2		rrca
		jr	nc,.edge3
		ld	(iy - TILEMAP_CHAR_WIDTH + 2),d
		ld	(iy - TILEMAP_CHAR_WIDTH + 1),d
		ld	(iy + 2),b
.edge3		rrca
		jr	nc,.edge4
		ld	(iy - TILEMAP_CHAR_WIDTH + 2),l
		ld	(iy - TILEMAP_CHAR_WIDTH + 1),b
		ld	(iy + 2),l
.edge4		rrca
		jr	nc,.edge5
		ld	(iy + TILEMAP_CHAR_WIDTH - 1),b
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH) - 1),e
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH)),e
.edge5		rrca
		jr	nc,.edge6
		ld	(iy + TILEMAP_CHAR_WIDTH - 1),h
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH) - 1),h
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH)),b
.edge6		rrca
		jr	nc,.edge7
		ld	(iy + TILEMAP_CHAR_WIDTH + 2),b
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH) + 1),e
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH) + 2),e
.edge7		rrca
		jr	nc,.iscorner
		ld	(iy + TILEMAP_CHAR_WIDTH + 2),l
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH) + 1),b
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH) + 2),l
.iscorner	pop	de
		pop	hl
		inc	l
		ld	a,(hl)
		or	a
		jr	z,.center_color
		srl	a
		jr	nc,.corner1
		ld	(iy - TILEMAP_CHAR_WIDTH - 1),b
		ld	(iy - TILEMAP_CHAR_WIDTH),b
		ld	(iy - 1),b
.corner1	srl	a
		jr	nc,.corner2
		ld	(iy - TILEMAP_CHAR_WIDTH + 1),b
		ld	(iy - TILEMAP_CHAR_WIDTH + 2),b
		ld	(iy + 2),b
.corner2	srl	a
		jr	nc,.corner3
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH) - 1),b
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH)),b
		ld	(iy + TILEMAP_CHAR_WIDTH - 1),b
.corner3	srl	a
		jr	nc,.ispoint
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH) + 2),b
		ld	(iy + (2 * TILEMAP_CHAR_WIDTH) + 1),b
		ld	(iy + TILEMAP_CHAR_WIDTH + 2),b
.ispoint	jr	z,.center_color
		ld	a,b
		add	a,(low playground.current_location) - 4
		ld	l,a
		ld	h,high playground.current_location
		ld	a,(hl)
		cp	xl
		ret	nz
		ld	a,b
		rlca
		rlca
		add	a,tilemap.endpoint.C1 - tilemap.base.ptr
		ld	(iy + 0),a
		inc	a
		ld	(iy + 1),a
		inc	a
		ld	(iy + TILEMAP_CHAR_WIDTH),a
		inc	a
		ld	(iy + TILEMAP_CHAR_WIDTH + 1),a
		ret

.center_color	ld	a,b
		jp	draw_center_color

; updating of numeral sprites with current steps
;------------------------------------------------------------------------------
redraw_numerals	ld	hl,sprattr.numeralC1 + S_SPRITE_ATTR.vpat
		ld	bc,S_SPRITE_ATTR - 1
		ld	d,#40
	dup 4, idx
		ld	e,b
		ld	a,(playground.steps + idx)
		srl	a
		rr	e
		or	d
		ld	(hl),a	; S_SPRITE_ATTR.vpat
		inc	l
		scf
		rr	e
		ld	(hl),e	; S_SPRITE_ATTR.ext
		add	hl,bc
	edup
		org	$-1
		inc	c
		dec	l	; S_SPRITE_ATTR.vpat
.color11	res	7,(hl)
		sbc	hl,bc
.color10	res	7,(hl)
		sbc	hl,bc
.color01	res	7,(hl)
		sbc	hl,bc
.color00	res	7,(hl)
		ld	bc,SPRITE_SLOT_SELECT_P_303B
		xor	a
		out	(c),a	; select slot 0
		ld	hl,sprattr.numeralC1
		ld	bc,(4 * S_SPRITE_ATTR * 256) + SPRITE_ATTRIBUTE_P_57
		otir
		ret

findplayablecolor
		xor	a
		ld	hl,playground.steps
		ld	e,a
.findnext	ld	bc,#0303
.loop		or	(hl)
		jr	nz,.setcolor
		ex	af,af'
		ld	a,l
		inc	a
		ld	l,a
		cp	4 + (low playground.steps)
		jr	c,.nowrap
		ld	l,low playground.steps
.nowrap		ex	af,af'
		djnz	.loop
		or	(hl)
		jr	z,reset_gloworb

.setcolor	ld	a,b
		xor	c
		add	a,e
		and	c
		ld	(active_color),a

reset_gloworb	ld	a,(active_color)
		ld	hl,playground.current_location
		add	hl,a
		inc	a	; color to palette shift
		swapnib		; PPPPxxxx
		ld	c,a	; store to C
		ld	de,$FF00 | PLAYFIELD_W
		ld	a,(hl)
.row		inc	d
		sub	e
		jr	nc,.row
		add	a,e	; X * 32
		ld	hl,-1
		rlca
		rlca
		add	hl,a
		add	hl,hl
		add	hl,hl
		add	hl,hl	; store to HL
.playfield_x	add	hl,0

		ld	a,d	; Y * 32
		swapnib
		rlca
.playfield_y	add	a,0
		sub	8
		ld	b,a	; store to B

		ex	hl,de
		ld	hl,sprattr.gloworb
		ld	a,#20	; anchor sprite
		call	.store_sprattr
		xor	a
		ld	(update_gloworb.ptr+1),a
		ld	de,16
		ld	b,0
		call	.store_sprattr
		ld	de,0
		ld	b,16
		call	.store_sprattr
		ld	de,16
		call	.store_sprattr
		ld	(update_gloworb+1),a
		ret

.store_sprattr	ex	af,af'
		ld	(hl),e	; S_SPRITE_ATTR.x
		inc	l
		ld	(hl),b	; S_SPRITE_ATTR.y
		inc	l
		ld	a,c
		or	d
		ld	(hl),a	; S_SPRITE_ATTR.palx8
		inc	l
		ld	(hl),#40 ; S_SPRITE_ATTR.vpat
		inc	l
		ex	af,af'
		or	#80
		ld	(hl),a	; S_SPRITE_ATTR.ext
		inc	l
		ret

update_gloworb	ld	a,0
		or	a
		ret	z
.ptr		ld	de,gloworb_animation_sprattrs
		ld	hl,sprattr.gloworb + 3
		ld	bc,S_SPRITE_ATTR - 1
		ld	a,(de)
		ld	(hl),a
		inc	e
		inc	hl
		ld	a,(de)
		ld	(hl),a
		inc	e
		add	hl,bc
		ld	a,(de)
		ld	(hl),a
		inc	e
		inc	hl
		ld	a,(de)
		ld	(hl),a
		inc	e
		add	hl,bc
		ld	a,(de)
		ld	(hl),a
		inc	e
		inc	hl
		ld	a,(de)
		ld	(hl),a
		inc	e
		add	hl,bc
		ld	a,(de)
		ld	(hl),a
		inc	e
		inc	hl
		ld	a,(de)
		ld	(hl),a
		inc	e
		ex	de,hl
		ld	(update_gloworb.ptr+1),hl
		xor	a
		or	l
		jr	z,.finaltouch
		ld	bc,SPRITE_SLOT_SELECT_P_303B
		ld	a,4
		out	(c),a	; select slot 0
		ld	hl,sprattr.gloworb
		ld	bc,(4 * S_SPRITE_ATTR * 256) + SPRITE_ATTRIBUTE_P_57
		otir
		ret

.finaltouch	call	update_gloworb
		xor	a
		ld	(update_gloworb+1),a
		ld	(update_gloworb.ptr+1),a
		ret
