prepare_level	cp	-1
		ret	z
		cp	LEVEL_CNT
		jr	c,.copy2pg

		xor	a
.copy2pg	ld	d,a
		ld	e,LEVEL_SIZE
		mul	d,e
		ld	hl,levels
		add	hl,de
		ld	de,playground
		ld	bc,LEVEL_SIZE
		ld	a,e
		ldir
		ld	h,d
		ld	l,e
		inc	de
		ld	bc,PLAYFIELD_SIZE*UNDO_LEVELS-1
		ld	(hl),a
		ldir

		dec	bc
		ld	(playground.current_location+0),bc
		ld	(playground.current_location+2),bc
		ld	a,#CC ; call z
		ld	(.firsttime),a
		ld	(.endno1stTime+1),a
;		ld	(store_undo.lastcolor+1),a
;		ld	(perform_move.makemove+1),a
		ld	a,#BF ; res 7,a
		ld	(redraw_bubbles.color00+1),a
		ld	(redraw_bubbles.color01+1),a
		ld	(redraw_bubbles.color10+1),a
		ld	(redraw_bubbles.color11+1),a

.justdraw	ld	de,tilemap_map + (3 * tilemap_map.x) + 3
		ld	ix,playground
		ld	c,PLAYFIELD_H
.rows		ld	b,PLAYFIELD_W
		push	de
.cols		ld	a,(ix+0)
		or	a
		jr	z,.next
		and	#FC
		cp	4
		push	bc
.firsttime	call	z,startile
		ld	l,(ix+0)
		ld	h,0
		add	hl,hl
		ld	bc,sprite2fntab
		add	hl,bc
		ld	a,(hl)
		ld	(draw_sprite+1),a
		inc	l
		ld	c,(hl)
		push	ix
		ld	xh,d
		ld	xl,e
		call	draw_sprite
		pop	ix
		pop	bc
.next		inc	ix
		add	de,4
		djnz	.cols
		pop	de
		add	de,tilemap_map.x * 4
		dec	c
		jr	nz,.rows
		call	redraw_bubbles
.endno1stTime	ld	a,0
		or	a
		jp	z,reset_color_keys
		ld	a,1
		ld	(.firsttime),a
		dec	a
		ld	(.endno1stTime+1),a
		jp	findplayablecolor

startile	ex	hl,de
		ld	bc,tilemap_map.x
		ld	a,3
.row		ex	af,af'
		xor	a
		or	b
		jr	nz,.nextrow
		or	c
		test	#C0
		jr	nz,.nextrow
		ld	l,a
		ld	h,0
		add	hl,hl
		add	hl,hl
		add	hl,hl
		ex	hl,de
		ld	a,(ix+0)
		and	3
		ld	b,a
		rlca
		rlca
		ld	h,high sprattr.numeralC1
		ld	l,a
		ld	(hl),e	; S_SPRITE_ATTR.x
		inc	l
		ex	af,af'
		rlca
		rlca
		rlca
		ld	(hl),a	; S_SPRITE_ATTR.y
		inc	l
		ld	a,b
		inc	a	; palette offset = blob color + 1
		swapnib
		or	d	; x8
		ld	(hl),a	; S_SPRITE_ATTR.palx8

		ld	a,b
		add	a,low playground.current_location
		ld	l,a
		ld	h,high playground.current_location
		ld	a,xl
		ld	(hl),a
		xor	a
		ld	l,b
		ld	h,a
		add	hl,hl
		add	hl,hl
		add	hl,hl
		ld	bc,redraw_bubbles.color00
		add	hl,bc
		dec	a ; #77 = set 7,a
		ld	(hl),a
		ret

.nextrow	xor	a
		sbc	hl,bc
		ex	af,af'
		inc	a
		jr	.row

draw_tiles_by_base
		ld	(ix - tilemap_map.x - 1),a
		inc	a
		ld	(ix - tilemap_map.x + 2),a
		inc	a
		ld	(ix + (2 * tilemap_map.x) - 1),a
		inc	a
		ld	(ix + (2 * tilemap_map.x) + 2),a
		inc	a
		ld	(ix - tilemap_map.x),a
		inc	a
		ld	(ix - tilemap_map.x + 1),a
		inc	a
		ld	(ix + (2 * tilemap_map.x)),a
		inc	a
		ld	(ix + (2 * tilemap_map.x) + 1),a
		inc	a
		ld	(ix - 1),a
		inc	a
		ld	(ix + 2),a
		inc	a
		ld	(ix + tilemap_map.x - 1),a
		inc	a
		ld	(ix + tilemap_map.x + 2),a
		ret

draw_center_of_tile
		ld	(ix + 0),h
		ld	(ix + 1),l
		ld	(ix + tilemap_map.x),b
		ld	(ix + tilemap_map.x + 1),c
		ret

draw_base	ld	a,tilemap.base.ptr
		call	draw_tiles_by_base
		xor	a
		add	a,c
		jr	z,.void
.center		ld	h,a
		inc	a
		ld	l,a
		inc	a
		ld	b,a
		inc	a
		ld	c,a
		jr	draw_center_of_tile

.void		ld	hl,(tilemap.tilebackground << 8) | tilemap.tilebackground
		ld	bc,(tilemap.tilebackground << 8) | tilemap.tilebackground
		jr	draw_center_of_tile

draw_blob	ld	a,c
		call	draw_tiles_by_base
		ld	a,c
		sub	tilemap.colorblob.C1
		swapnib
		add	a,tilemap.base.C1
		ld	(ix + 0),a
		ld	(ix + 1),a
		ld	(ix + tilemap_map.x),a
		ld	(ix + tilemap_map.x + 1),a
		ret

draw_blocked	ld	a,tilemap.blocked.ptr
		call	draw_tiles_by_base
		ld	a,tilemap.blocked.cross
		jr	draw_base.center

draw_sprite	jr	$+2
		jr	draw_base	; TILE_BASE
		jr	draw_blob	; TILE_BLOB
		jr	draw_blocked	; TILE_BLOCKED
		jr	draw_tele	; TILE_TELE
		jr	draw_path	; TILE_PATH
		jr	draw_cross	; TILE_CROSS
		ret

draw_tele	ld	a,tilemap.base.ptr
		call	draw_tiles_by_base
		ld	a,tilemap.teleport
.phase		add	a,0
		jr	draw_base.center

draw_path	ret

draw_cross	ret

;------------------------------------------------------------------------------

redraw_bubbles	ld	hl,sprattr.numeralC1 + S_SPRITE_ATTR.vpat
		ld	bc,4
		ld	a,(playground.steps+0)
.color00	res	7,a
		nop			; reserved
		ld	(hl),a
		add	hl,bc
		ld	a,(playground.steps+1)
.color01	res	7,a
		nop			; reserved
		ld	(hl),a
		add	hl,bc
		ld	a,(playground.steps+2)
.color10	res	7,a
		nop			; reserved
		ld	(hl),a
		add	hl,bc
		ld	a,(playground.steps+3)
.color11	res	7,a
		nop			; reserved
		ld	(hl),a
		ret

findplayablecolor
		xor	a
		ld	hl,playground.steps
		ld	e,a
.findnext	ld	bc,#0303
.loop		or	(hl)
		jr	nz,.setcolor
		ex	af,af'
		ld	a,l
		inc	a
		ld	l,a
		cp	4 + (low playground.steps)
		jr	c,.nowrap
		ld	l,low playground.steps
.nowrap		ex	af,af'
		djnz	.loop
		or	(hl)
		jr	z,reset_color_keys

.setcolor	ld	a,b
		xor	c
		add	a,e
		and	c
		ld	(active_color),a

reset_color_keys
		;; TODO
		ret
